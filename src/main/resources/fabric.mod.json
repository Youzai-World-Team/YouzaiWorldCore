{
  "schemaVersion": 1,
  "id": "youzaiworldcore",
  "version": "${version}",
  "name": "YouzaiWorldCore",
  "description": "This is the core mod of Youzai World Server.",
  "authors": [
    "zxabinbina",
    "ress2338396",
    "Maskviva",
    "why",
    "byzzdemy",
    "zhongend",
    "Youzai World Team"
  ],
  "contributors": [
    "lucko",
    "MDLC01",
    "Fogg05"
  ],
  "contact": {
    "homepage": "https://mcyzw.top",
    "sources": "https://github.com/Youzai-World-Team/YouzaiWorldCore",
    "issues": "https://github.com/Youzai-World-Team/YouzaiWorldCore/issues"
  },
  "license": "Apache-2.0",
  "icon": "icon.png",
  "environment": "*",
  "languageAdapters": {
    "youzaiworldcore:startup_loading": "top.csituka.youzaiworldcore.startup.StartupLoadingLanguageAdapter"
  },
  "entrypoints": {
    "preLaunch": [
      {
        "adapter": "youzaiworldcore:startup_loading",
        "value": "top.csituka.youzaiworldcore.startup.StartupSplashPreLaunch"
      }
    ],
    "fabric-datagen": [
      "top.csituka.youzaiworldcore.client.DataGenerator"
    ],
    "client": [
      "top.csituka.youzaiworldcore.client.Client"
    ],
    "main": [
      "top.csituka.youzaiworldcore.YouzaiworldCore"
    ],
    "modmenu": [
      "top.csituka.youzaiworldcore.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "youzaiworldcore.mixins.json",
    {
      "config": "youzaiworldcore.server.mixins.json",
      "environment": "server"
    },
    {
      "config": "youzaiworldcore.account.mixins.json",
      "environment": "server"
    },
    {
      "config": "youzaiworldcore.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "youzaiworldcore.client.accesswidener",
  "depends": {
    "fabric-api": ">=0.154.0+26.2",
    "minecraft": ">=${minecraft_version}",
    "placeholder-api": ">=3.0.0",
    "modmenu": ">=20.0.0-beta.4",
    "moogs_structures": ">=3.0.4",
    "trinkets_updated": "=${trinkets_version}",
    "geckolib": ">=5.5.3"
  },
  "suggests": {
    "luckperms": "*",
    "advancementplaques": "*",
    "EnchantmentDescriptions": "*",
    "sophisticatedbackpacks": "*",
    "jade": "*"
  },
  "custom": {
    "modmenu": {
      "update_checker": false
    }
  }
}
